{
  "$id": "https://appsdk.local/contracts/records/evidence-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "development_whitebox"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "execution_surface": {
            "const": "development_whitebox"
          }
        },
        "required": [
          "execution_surface"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "deployed_blackbox"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "artifact_hash": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "entrypoint": {
            "minLength": 1,
            "type": "string"
          },
          "environment_id": {
            "minLength": 1,
            "type": "string"
          },
          "execution_surface": {
            "const": "deployed_blackbox"
          },
          "kind": {
            "enum": [
              "runtime",
              "sample_replay"
            ]
          }
        },
        "required": [
          "artifact_hash",
          "execution_surface",
          "environment_id",
          "entrypoint"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "deployment_install",
              "deployment_restart"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "artifact_hash": {
            "minLength": 1,
            "type": "string"
          },
          "entrypoint": {
            "minLength": 1,
            "type": "string"
          },
          "environment_id": {
            "minLength": 1,
            "type": "string"
          },
          "execution_surface": {
            "const": "deployed_blackbox"
          }
        },
        "required": [
          "artifact_hash",
          "execution_surface",
          "environment_id",
          "entrypoint"
        ]
      }
    }
  ],
  "properties": {
    "artifact_hash": {
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "confidence_rationale": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "entrypoint": {
      "type": "string"
    },
    "environment_id": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "execution_surface": {
      "enum": [
        "development_whitebox",
        "deployed_blackbox"
      ]
    },
    "experiment_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "input_hashes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "issue_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "red_test",
        "positive_test",
        "negative_test",
        "sample_replay",
        "build",
        "install",
        "restart",
        "artifact",
        "runtime",
        "gate"
      ]
    },
    "phase": {
      "enum": [
        "baseline_reproduction",
        "fix_candidate",
        "positive_intervention",
        "negative_intervention",
        "development_whitebox",
        "deployment_install",
        "deployment_restart",
        "deployed_blackbox",
        "post_architecture_effectiveness",
        "regression",
        "artifact"
      ]
    },
    "producer": {
      "properties": {
        "adapter": {
          "minLength": 1,
          "type": "string"
        },
        "identity": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "identity"
      ],
      "type": "object"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "scope": {
      "properties": {
        "entrypoint": {
          "type": "string"
        },
        "feature_id": {
          "type": "string"
        },
        "module_id": {
          "type": "string"
        }
      },
      "required": [
        "module_id"
      ],
      "type": "object"
    },
    "scope_hash": {
      "type": "string"
    },
    "source_commit": {
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "issue_id",
    "experiment_id",
    "phase",
    "kind",
    "source_commit",
    "scope",
    "producer",
    "result",
    "created_at",
    "expires_at",
    "input_hashes",
    "scope_hash"
  ],
  "type": "object"
}
