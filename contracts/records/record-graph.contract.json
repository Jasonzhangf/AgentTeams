{
  "$id": "https://appsdk.local/contracts/records/record-graph.contract.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "fix_lifecycle": {
      "properties": {
        "invalidation": {
          "const": "candidate_commit_tree_artifact_environment_entrypoint_install_restart_receipt_or_scope_change_invalidates_pre_review_validation_review_and_effectiveness"
        },
        "merge_identity": {
          "const": "candidate_commit_must_be_ancestor_of_tested_integration_commit_and_merged_tree_must_equal_tested_integration_tree"
        },
        "parallel_order": {
          "const": [
            "collaboration_claimed",
            "clean_worktree",
            "baseline_reproduction",
            "fix_candidate_verified",
            "development_whitebox_pass",
            "deployed_blackbox_pass",
            "pre_review_validation_pass",
            "architecture_review_pass",
            "post_architecture_effectiveness_pass",
            "merge_queued",
            "integration_verified",
            "mainline_merged",
            "remote_verified",
            "collab_live_closed",
            "promotion_recorded"
          ]
        },
        "single_order": {
          "const": [
            "clean_worktree",
            "baseline_reproduction",
            "fix_candidate_verified",
            "development_whitebox_pass",
            "deployed_blackbox_pass",
            "pre_review_validation_pass",
            "architecture_review_pass",
            "post_architecture_effectiveness_pass",
            "mainline_merged"
          ]
        }
      },
      "required": [
        "single_order",
        "parallel_order",
        "invalidation",
        "merge_identity"
      ],
      "type": "object"
    },
    "freshness_rules": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "regression_rules": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "rules": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "rules",
    "freshness_rules",
    "fix_lifecycle"
  ],
  "type": "object"
}
