{
  "$id": "https://appsdk.local/contracts/records/goal-clarification-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acceptance_criteria": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "ambiguities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "confirmed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "issue_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "non_goals": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "questions": {
      "items": {
        "properties": {
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "question": {
            "type": "string"
          },
          "question_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "answered",
              "not_required"
            ]
          }
        },
        "required": [
          "question_id",
          "question",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "raw_request": {
      "minLength": 1,
      "type": "string"
    },
    "requirements_version": {
      "minimum": 0,
      "type": "integer"
    },
    "risk_decisions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "scope": {
      "properties": {
        "allowed_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "feature_id": {
          "type": "string"
        },
        "forbidden_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "module_id": {
          "type": "string"
        },
        "resource_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "status": {
      "enum": [
        "received",
        "parsed",
        "clarification_pending",
        "confirmed",
        "admitted",
        "superseded"
      ]
    },
    "understood_objective": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "goal_id",
    "raw_request",
    "understood_objective",
    "acceptance_criteria",
    "non_goals",
    "assumptions",
    "ambiguities",
    "questions",
    "status",
    "created_at"
  ],
  "type": "object"
}
