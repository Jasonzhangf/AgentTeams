  "verification_gates": [
    {
      "id": "gate.console.resource-boundary",
      "status": "pending",
      "required": true,
      "checks": [
        "control routing is not carried in business payload metadata",
        "machine/session address resolves before Session API invocation"
      ]
    },
    {
      "id": "gate.console.single-owner",
      "status": "pending",
      "required": true,
      "checks": [
        "one owner for machine connections",
        "one owner for relation truth",
        "one owner for drawer navigation",
        "existing Conversation pipeline remains the Session presentation owner"
      ]
    },
    {
      "id": "gate.console.ui-accessibility",
      "status": "pending",
      "required": true,
      "checks": [
        "keyboard and screen-reader drawer navigation",
        "focus restoration",
        "reduced motion",
        "non-color status semantics",
        "mobile touch target and zoom behavior"
      ]
    },
    {
      "id": "gate.console.desktop-mobile-equivalence",
      "status": "pending",
      "required": true,
      "checks": [
        "shared semantic components",
        "layout-only desktop/mobile divergence",
        "same status and action semantics"
      ]
    },
    {
      "id": "gate.console.runtime-smoke",
      "status": "pending",
      "required": true,
      "checks": [
        "two-machine live summary",
        "any-agent Session navigation",
        "nested drawer push/pop",
        "connected/reconnecting/disconnected distinction",
        "real browser desktop and mobile viewport"
      ]
    }
  ],
  "approval_required": [],
  "frozen_implementation_defaults": {
    "machine_authentication": [
      "none",
      "shared-api-key",
      "shared-token"
    ],
    "relation_authority": "graph classification never grants capability permission",
    "cross_machine_business_routing": "host-to-host; UI is not a business relay",
    "display_name_truth": "host canonical name; console local alias is projection-only",
    "credential_persistence": "opaque reference only; secret is owned outside Teams",
    "config_conflict": "revision compare-and-swap with explicit conflict",
    "relation_report_freshness": {
      "heartbeat_seconds": 30,
      "ttl_seconds": 90,
      "expiry_projection": "stale",
      "history_retention": "retain"
    }
  },
  "design_reference": {
    "prototype": "docs/design/multi-agent-console-prototype.html",
