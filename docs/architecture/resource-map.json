{
  "schema_version": 1,
  "map_id": "teams-resource-map",
  "status": "partial",
  "resources": [
    {"resource_id":"cli-execution-error","owner":"control-protocol","kind":"control_resource","status":"partial","truth_store":"ServiceError.execution in Work error chain","allowed_operations":["validate","persist","transmit"],"note":"Adapter execution code, message, context, exit/signal and stdout/stderr remain intact; no state reconstruction from diagnostic text."},
    {"resource_id":"daemon-local-ownership","owner":"runtime","kind":"control_resource","status":"partial","truth_store":"configured loopback lease listener plus durable data-directory identity/leasePort binding and runtime-owner record","allowed_operations":["bind_exclusive","verify_identity","verify_previous_owner","release_after_shutdown"],"note":"Reacquiring the configured lease and matching the prior runtime-owner PID/start token proves a stale Work lock belonged to the exited daemon owner; filesystem/log content alone does not prove exit. Outstanding Work recovery remains separately evidence-gated."},
    {"resource_id":"relay-client-requests","owner":"network","kind":"control_resource","status":"partial","truth_store":"network/relay-client.ts live pending request and data socket registries","allowed_operations":["query","connect","correlate","expire_unknown","close"],"note":"No automatic replay; data socket closure does not prove Work completion"},
    {"resource_id":"wss-client-socket","owner":"network","kind":"control_resource","status":"partial","truth_store":"network/wss-connection.ts live TLS socket and bounded unread/send buffers","allowed_operations":["connect","read_frame","send_frame","close"],"note":"Socket open/write is not relay admission or work completion; authentication stays in the dedicated HTTP header"},
    {"resource_id":"protocol-business-json","owner":"control-protocol","kind":"business_resource","truth_store":"validated business JSON in the declared payload/body/metadata/delta location; never transport or auth truth","allowed_operations":["validate_without_coercion","preserve"]},
    {"resource_id":"agent-service-contracts-r1","owner":"control-protocol","kind":"control_contract","status":"design","truth_store":"control-protocol/agent-services.ts; definitions only, service behavior remains pending","allowed_operations":["read","typecheck","review"]},
    {"resource_id":"development-artifact","owner":"development-governance","kind":"build_artifact","truth_store":"generated/modules/teams-source/lib; current package builds, not a deployed service","allowed_operations":["build","package","verify"]},
    {"resource_id":"relay-service-capabilities","owner":"server","kind":"control_resource","status":"design","truth_store":"relay service declared directory/broadcast/connection-assistance/STUN/traversal/traffic-relay support","allowed_operations":["declare","authenticate","query"]},
    {"resource_id":"endpoint-discovery-view","owner":"server","kind":"control_resource","status":"partial","truth_store":"server/endpoint-discovery.ts scope-filtered Endpoint summaries on relay directory/changed peers","allowed_operations":["compile_admission","filter_scope","admit_reference"],"forbidden_relations":["target_transport","business_payload","session_body"]},
    {"resource_id":"provider-instance-config","owner":"config","kind":"control_resource","status":"design","truth_store":"target daemon durable versioned LLM provider instances; credential references only","allowed_operations":["read","validate","compare_and_swap"]},
    {"resource_id":"provider-model-catalog","owner":"config","kind":"control_resource","status":"design","truth_store":"per-instance discovered/manual model entries with separate user overrides","allowed_operations":["refresh","read","override","report_error"]},
    {"resource_id":"capability-descriptor","owner":"agent","kind":"control_resource","status":"design","truth_store":"provider Agent versioned interface/operation declarations","allowed_operations":["declare","publish","read","match"]},
    {"resource_id":"agent-resource-descriptor","owner":"agent","kind":"control_resource","status":"design","truth_store":"provider Agent resource capacity/unit/sharing declarations","allowed_operations":["declare","publish","read"]},
    {"resource_id":"agent-resource-allocation","owner":"agent","kind":"control_resource","status":"design","truth_store":"provider Agent atomic resource allocation ledger","allowed_operations":["admit","allocate","observe","release_after_confirmed_completion"]},
    {"resource_id":"agent-work","owner":"agent","kind":"control_resource","status":"design","truth_store":"provider accepted work and policy; consumer owns its local reference","allowed_operations":["propose","accept","reject","request","close"]},
