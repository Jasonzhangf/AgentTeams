          "to": "replay_native"
        },
        {
          "from": "replay_native",
          "to": "consume_receipt"
        }
      ],
      "entry_node": "preserve_error",
      "nodes": [
        {
          "evidence": [
            "communication-failure-record"
          ],
          "instruction": "Persist the exact error, durable IDs, source commit, installed binary, daemon PID/socket, and current task/bug binding; do not classify ACK, notification acceptance, health, or timeout as delivery.",
          "node_id": "preserve_error",
          "owner": "project"
        },
        {
          "evidence": [
            "communication-state"
          ],
          "instruction": "Run `collab context` once and read the returned identity, route, daemon, task, inbox, and authority state. If the daemon is explicitly down or context returns a runtime error, preserve the exact error and stop; daemon maintenance is human-authorized.",
          "node_id": "inspect_state",
          "owner": "project"
        },
        {
          "evidence": [
            "recovery-receipt"
          ],
          "instruction": "If context returns `required_fields`, supply only those real facts once with `collab context --provide '<JSON>'`. The supplement may contain only requested `session_id`, `thread_id`, `endpoint`, or `namespace` facts; it never supplies a worker, approval, token, route, or binding. The daemon owns identity creation, selection, recovery, registration, route publication, and lease restoration. Do not choose or hunt a worker and do not run a separate recovery command.",
          "node_id": "recover_route",
          "owner": "project"
        },
        {
          "evidence": [
            "recovered-route"
          ],
          "instruction": "Use the snapshot returned by context or its one factual supplement. Continue only when it is registered and the target route is live; otherwise preserve the exact failure and stop.",
          "node_id": "verify_route",
          "owner": "project"
        },
        {
          "evidence": [
            "native-target-result"
          ],
          "instruction": "Replay the same native target through the installed binary and record the target result item; queue acceptance or a daemon health response alone is insufficient.",
          "node_id": "replay_native",
          "owner": "project"
        },
        {
          "evidence": [
            "durable-receipt",
            "issue-update"
          ],
          "instruction": "Consume the durable receipt for the target result through the canonical receive/consume operation; read-only inspection alone does not close. Update the bound bug or feature record and close only when the result and receipt evidence are present.",
          "node_id": "consume_receipt",
          "owner": "project"
        }
      ],
      "objective": "Restore communication after an exact route, identity, daemon, or transport failure and prove the original native path again."
    },
